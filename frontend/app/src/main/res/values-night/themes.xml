<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Pulse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core colors – dark variants -->
        <item name="colorPrimary">@color/dark_primary_green</item>
        <item name="colorPrimaryVariant">@color/dark_primary_green</item>
        <item name="colorOnPrimary">@color/dark_button_text</item>

        <item name="colorSecondary">@color/dark_primary_green</item>
        <item name="colorSecondaryVariant">@color/dark_primary_green</item>
        <item name="colorOnSecondary">@color/dark_button_text</item>

        <!-- Background & surface -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_background</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorSurfaceVariant">@color/dark_card_bg</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_sub</item>

        <!--    Custom Colors    -->
        <item name="colorCopyright">@color/dark_text_copyright</item>
        <item name="color_text_75">@color/dark_text_75</item>
        <item name="colorBg65">@color/dark_bg_65</item>
        <item name="progressIndicatorActive">@color/dark_green_50</item>
        <item name="progressIndicatorInactive">@color/dark_green_15</item>
        <item name="colorTextField">@color/dark_textfield_bg</item>
        <item name="colorAuthSubtext1">@color/dark_text_85</item>
        <item name="colorAuthLink">@color/dark_text_green_95</item>
        <item name="colorAuthFooter">@color/dark_text_55</item>
        <item name="colorBtmNavBg">@color/dark_bg_65</item>
        <item name="colorBtmNavBgSelected">@color/dark_nav_bg_selected</item>
        <item name="colorCardBg">@color/dark_card_bg</item>
        <item name="colorAppointD">@color/dark_badge_bg_65</item>
        <item name="colorGreenCard">@color/dark_green_70</item>
        <item name="color70">@color/dark_text_70</item>
        <item name="colorAppointCardBtnBg">@color/dark_badge_bg_35</item>
        <item name="colorGreen30">@color/dark_green_30</item>
        <item name="colorWhiteChipBg">@color/dark_badge_bg_white_15</item>
        <item name="color40">@color/dark_text_40</item>
        <item name="colorBg80">@color/dark_green_80</item>


        <!-- Error stays the same (red is universal) -->
        <item name="colorError">@color/emergency_button_bg</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- Status & navigation bar – dark mode -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>   <!-- light icons on dark bg -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Text appearances -->
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="fontFamily">@font/inter_family</item>

        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_sub</item>

        <item name="textAppearanceTitleLarge">@style/AppText</item>
        <item name="textAppearanceTitleMedium">@style/AppText</item>
        <item name="textAppearanceBodySmall">@style/AppText</item>
        <item name="textAppearanceBodyLarge">@style/AppText</item>
        <item name="textAppearanceBodyMedium">@style/AppText</item>
        <item name="textAppearanceLabelLarge">@style/AppButtonText</item>
    </style>

    <style name="AppText" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <style name="AppButtonText" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_family</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.Pulse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

</resources>