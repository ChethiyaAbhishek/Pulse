<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/value_8dp"
    android:layout_marginBottom="@dimen/value_8dp"
    app:cardCornerRadius="@dimen/value_15dp">

    <LinearLayout
        android:id="@+id/consultantCardLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="?attr/colorCardBg"
        android:padding="@dimen/padding_10">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/consultant_card_hospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/appointment_date_bg"
                android:gravity="center"
                android:paddingVertical="@dimen/value_5dp"
                android:paddingStart="@dimen/padding_10"
                android:paddingEnd="@dimen/padding_10"
                android:text="Nawaloka Hospitals PLC"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/size_11" />

            <TextView
                android:id="@+id/consultant_card_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Dr Isuru Gallage"
                android:textColor="?attr/color_text_75"
                android:textSize="@dimen/size_20"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/consultant_card_speciality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Neurologist"
                android:textColor="?attr/color_text_75"
                android:textSize="@dimen/size_12" />

            <TextView
                android:id="@+id/consultant_card_base_hospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="National Hospital Colombo"
                android:textColor="?attr/color40"
                android:textSize="@dimen/size_12" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:layout_gravity="center"
            android:id="@+id/consultant_card_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_30dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.chip.Chip
                    android:id="@+id/consultantCardSlot1"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:text="10.00 PM"
                    android:textSize="@dimen/size_11" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/consultantCardSlot2"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:text="10.00 PM"
                    android:textSize="@dimen/size_11" />

            </LinearLayout>

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>