<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/confirmation_alert_bg"
    android:padding="@dimen/padding_10">

    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:src="@drawable/calendar_checked_icon" />

    <TextView
        android:layout_width="match_parent"
        android:textAlignment="center"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_15dp"
        android:text="Booking Confirmed !"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/size_24"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginTop="@dimen/value_5dp"
        android:text="Your booking is confirmed. Please find the\ndetails below,"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_15dp"
        app:cardBackgroundColor="?attr/colorTextField"
        app:cardCornerRadius="@dimen/value_15dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/value_15dp">

            <TextView
                android:id="@+id/appointmentConHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nawaloka Hospitals PLC"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/size_20"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/appointmentConConsultantLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentConHospital">

                <ImageView
                    android:layout_width="@dimen/value_15dp"
                    android:layout_height="@dimen/value_15dp"
                    android:src="@drawable/channel_icon"
                    app:tint="?attr/color_text_75" />

                <TextView
                    android:id="@+id/appointmentConConsultantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/value_15dp"
                    android:text="Dr Isuru Perera"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/appointmentConDateLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentConConsultantLayout">

                <ImageView
                    android:layout_width="@dimen/value_15dp"
                    android:layout_height="@dimen/value_15dp"
                    android:src="@drawable/calendar_icon"
                    app:tint="?attr/color_text_75" />

                <TextView
                    android:id="@+id/appointmentConDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/value_15dp"
                    android:text="Feb 24, 2026"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/appointmentConTimeLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentConDateLayout">

                <ImageView
                    android:layout_width="@dimen/value_15dp"
                    android:layout_height="@dimen/value_15dp"
                    android:src="@drawable/clock_icon"
                    app:tint="?attr/color_text_75" />

                <TextView
                    android:id="@+id/appointmentConTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/value_15dp"
                    android:text="04.30 PM - 05.00 PM"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentConTimeLayout">

                <ImageView
                    android:layout_width="@dimen/value_15dp"
                    android:layout_height="@dimen/value_15dp"
                    android:src="@drawable/location_icon_24"
                    app:tint="?attr/color_text_75" />

                <TextView
                    android:id="@+id/appointmentConMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/value_15dp"
                    android:text="Onsite"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/appointmentConMapContainer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="@dimen/value_15dp"
        app:cardBackgroundColor="?attr/colorTextField"
        app:cardCornerRadius="@dimen/value_15dp" />

<!--    <com.google.android.material.button.MaterialButton-->
<!--        android:id="@+id/appointmentConHospitalBtn"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="@dimen/btn_height"-->
<!--        android:layout_marginTop="@dimen/value_15dp"-->
<!--        android:layout_marginBottom="@dimen/value_15dp"-->
<!--        android:text="Back to Home"-->
<!--        android:textSize="@dimen/size_17"-->
<!--        android:textStyle="bold" />-->

</LinearLayout>