<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_padding"
    tools:context=".activity.HeartRateMonitoringActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/hrmBtnBack"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:layout_alignParentStart="true"
            android:background="@drawable/circular_btn_shape"
            android:src="@drawable/back_arrow" />

        <Button
            android:id="@+id/hrmBtnEmergency"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_alignParentEnd="true"
            android:background="@drawable/emergency_btn_bg"
            android:paddingStart="@dimen/value_15dp"
            android:paddingEnd="@dimen/value_15dp"
            android:text="@string/emergency_btn_text"
            android:textColor="@color/light_button_text"
            android:textSize="@dimen/regular_size_16"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_24dp"
        android:text="Heart Rate Monitor"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_24"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Track your heart rate for fitness and health."
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.chip.Chip
            android:id="@+id/hrmInstructionChip"
            android:layout_marginTop="@dimen/value_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Place index finger firmly\\nover camera + flash"
            android:textAlignment="center"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_12" />

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="24dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/value_15dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/value_15dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/value_15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/hrmProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:progress="55"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="230dp"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackThickness="@dimen/value_8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/hrmBpmValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="72"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="100sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BPM"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/size_24"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!--        <FrameLayout-->
        <!--            android:id="@+id/graphContainer"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="180dp"-->
        <!--            android:layout_marginHorizontal="16dp"-->
        <!--            android:layout_marginBottom="16dp"-->
        <!--            android:background="@drawable/bg_graph_container"-->
        <!--            app:layout_constraintBottom_toTopOf="@id/cardsContainer">-->

        <!--            <com.github.mikephil.charting.charts.LineChart-->
        <!--                android:id="@+id/chartPpg"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="match_parent"-->
        <!--                android:padding="8dp" />-->

        <!--            &lt;!&ndash; Graph Title Overlay &ndash;&gt;-->
        <!--            <TextView-->
        <!--                android:layout_width="wrap_content"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:layout_gravity="top|start"-->
        <!--                android:layout_margin="12dp"-->
        <!--                android:alpha="0.7"-->
        <!--                android:text="@string/label_ppg_waveform"-->
        <!--                android:textColor="?attr/colorOnSurfaceVariant"-->
        <!--                android:textSize="12sp" />-->
        <!--        </FrameLayout>-->

        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg_2"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/value_15dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current BPM: "
                        android:textSize="@dimen/size_14" />

                    <TextView
                        android:id="@+id/hrmCurrentBpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/value_8dp"
                        android:text="72"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/size_24"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/value_8dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg_2"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/value_15dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status: "
                        android:textSize="@dimen/size_14" />

                    <TextView
                        android:id="@+id/hrmStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/value_8dp"
                        android:text="NORMAL"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/size_17"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hrmMeasurementBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:text="Start Measurement"
                android:layout_marginTop="@dimen/value_15dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="?attr/colorError" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>