<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.ConsultantAppointmentFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/conAppointmentConsultantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dr Isuru Gallage"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/size_24"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/conAppointmentConsultantSpec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Neurologist"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

                <TextView
                    android:id="@+id/conAppointmentConsultantBasHos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="National Hospital, Colombo"
                    android:textColor="?attr/color40"
                    android:textSize="@dimen/size_14" />
            </LinearLayout>

<!--            <ImageButton-->
<!--                android:id="@+id/hosAppointmentLocationBtn"-->
<!--                android:layout_width="@dimen/value_45dp"-->
<!--                android:layout_height="@dimen/value_45dp"-->
<!--                android:layout_marginEnd="@dimen/value_18dp"-->
<!--                android:background="@drawable/circular_btn_shape"-->
<!--                android:src="@drawable/location_icon_24"/>-->

<!--            <ImageButton-->
<!--                android:id="@+id/hosAppointmentCallBtn"-->
<!--                android:layout_width="@dimen/value_45dp"-->
<!--                android:layout_height="@dimen/value_45dp"-->
<!--                android:background="@drawable/circular_btn_shape"-->
<!--                android:src="@drawable/call_icon_24" />-->

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_24dp"
            android:text="Hospital"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/regular_size_16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/conAppointmentSearchField"
                android:layout_width="0dp"
                android:layout_height="@dimen/value_35dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:drawableEnd="@drawable/audio_icon"
                android:drawablePadding="@dimen/padding_10"
                android:hint="Search Hospital"
                android:inputType="text"
                android:padding="@dimen/padding_10"
                android:textColor="?attr/color_text_75"
                android:textColorHint="?attr/color_text_75"
                android:textSize="@dimen/size_14" />

            <ImageButton
                android:id="@+id/conAppointmentSearchBtn"
                android:layout_width="@dimen/value_35dp"
                android:layout_height="@dimen/value_35dp"
                android:layout_marginStart="@dimen/value_5dp"
                android:background="@drawable/circular_btn_shape"
                android:src="@drawable/search_icon" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conAppointmentHosRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/conAppointmentHosError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_15dp"
            android:layout_marginTop="@dimen/value_5dp"
            android:text="Select a hospital"
            android:textColor="@color/emergency_button_bg"
            android:visibility="gone" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHosNotFound"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/value_8dp"
            android:paddingEnd="@dimen/value_8dp"
            android:visibility="gone"
            android:text="No Hospitals Found  "
            android:textColor="?attr/color_text_75"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="?attr/colorCardBg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_24dp"
            android:text="Appointment Date"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/regular_size_16" />

        <TextView
            android:id="@+id/conAppointmentAvaiDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="?attr/color70"
            android:textSize="@dimen/size_12" />

        <CalendarView
            android:id="@+id/conAppointmentCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weekDayTextAppearance="@style/TextAppearance.AppCompat.Small"
            />

        <TextView
            android:id="@+id/conAppointmentCalendarError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_15dp"
            android:layout_marginBottom="@dimen/value_8dp"
            android:text="Select an appointment date"
            android:textColor="@color/emergency_button_bg"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appointment Time"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/regular_size_16" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conAppointmentSlotsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp" />

        <TextView
            android:id="@+id/conAppointmentSlotError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_15dp"
            android:layout_marginTop="@dimen/value_5dp"
            android:text="Select an appointment slot"
            android:textColor="@color/emergency_button_bg"
            android:visibility="gone" />

        <com.google.android.material.chip.Chip
            android:id="@+id/conAppointmentSlotsUnavailableChip"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/value_15dp"
            android:paddingEnd="@dimen/value_15dp"
            android:visibility="gone"
            android:text="No available slots  "
            android:textColor="?attr/color_text_75"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="?attr/colorCardBg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_24dp"
            android:text="Appointment Mode"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/regular_size_16" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/conAppointmentchipGroupMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/conAppointmentChipOnsite"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Onsite "
                android:paddingStart="@dimen/value_15dp"
                android:paddingEnd="@dimen/value_15dp"
                android:textColor="?attr/color_text_75"
                app:checkedIconVisible="false"
                android:background="@drawable/chip_background" />

            <com.google.android.material.chip.Chip
                android:id="@+id/conAppointmentChipOnline"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online "
                android:paddingStart="@dimen/value_15dp"
                android:paddingEnd="@dimen/value_15dp"
                android:textColor="?attr/color_text_75"
                app:checkedIconVisible="false"
                android:background="@drawable/chip_background" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/conAppointmentModeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_15dp"
            android:layout_marginTop="@dimen/value_5dp"
            android:text="Select an appointment mode"
            android:textColor="@color/emergency_button_bg"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_24dp"
            android:text="Payment"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/regular_size_16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:layout_marginBottom="@dimen/value_15dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Consultant Charges"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

                <TextView
                    android:id="@+id/conAppointmentConsultantFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 6000.0"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hospital Charges"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

                <TextView
                    android:id="@+id/conAppointmentHospitalFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 1000.0"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Platform Charges"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

                <TextView
                    android:id="@+id/conAppointmentPlatformFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 500.0"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />
            </LinearLayout>

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/color_text_75" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Amount"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/regular_size_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/conAppointmentTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 7500.0"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/regular_size_16"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/conAppointmentPaymentBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/value_24dp"
                android:text="Pay &amp; Book Now"
                android:textSize="@dimen/size_17"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>