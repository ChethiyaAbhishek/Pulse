<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ReportViewActivity">

    <RelativeLayout
        android:id="@+id/reportViewHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/value_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/reportViewClose"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:layout_alignParentEnd="true"
            android:background="@drawable/circular_btn_shape"
            android:src="@drawable/close_icon" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/reportViewImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reportViewHeader"/>

</androidx.constraintlayout.widget.ConstraintLayout>