<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="@dimen/activity_padding"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.PreviousAppointmentsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/preAppointmentBtnBack"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:layout_alignParentStart="true"
            android:background="@drawable/circular_btn_shape"
            android:src="@drawable/back_arrow" />

        <Button
            android:id="@+id/preAppointmentBtnEmergency"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_alignParentEnd="true"
            android:background="@drawable/emergency_btn_bg"
            android:paddingStart="@dimen/value_15dp"
            android:paddingEnd="@dimen/value_15dp"
            android:text="@string/emergency_btn_text"
            android:textColor="@color/light_button_text"
            android:textSize="@dimen/regular_size_16"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_24dp"
        android:text="Your Bookings"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_24"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Track upcoming and past bookings"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/preAppointmentsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:layout_marginTop="@dimen/value_24dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/noPreAppointmentsCard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/value_35dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/value_15dp">

        <LinearLayout
            android:id="@+id/consultantCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="?attr/colorCardBg"
            android:orientation="vertical"
            android:padding="@dimen/padding_10">

            <TextView
                android:id="@+id/consultant_card_base_hospital"
                android:layout_width="match_parent"
                android:textAlignment="center"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="No Scheduled Appointments"
                android:textColor="?attr/color_text_75"
                android:textSize="@dimen/size_12" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/preAppointmentLoading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:layout_weight="1"
        android:orientation="vertical">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </LinearLayout>

</LinearLayout>