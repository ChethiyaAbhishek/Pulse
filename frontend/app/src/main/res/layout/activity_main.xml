<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/value_15dp"
            android:paddingTop="@dimen/value_15dp"
            android:paddingEnd="@dimen/value_15dp">

            <ImageButton
                android:id="@+id/sideMenu"
                android:layout_width="@dimen/circular_btn"
                android:layout_height="@dimen/circular_btn"
                android:background="@drawable/circular_btn_shape"
                android:src="@drawable/menu_icon" />

            <ImageButton
                android:visibility="gone"
                android:id="@+id/notifications"
                android:layout_width="@dimen/circular_btn"
                android:layout_height="@dimen/circular_btn"
                android:layout_marginStart="@dimen/value_15dp"
                android:background="@drawable/circular_btn_shape"
                android:src="@drawable/notification_icon" />

            <Button
                android:id="@+id/emergencyBtnMain"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_gravity="end"
                android:background="@drawable/emergency_btn_bg"
                android:paddingStart="@dimen/value_15dp"
                android:paddingEnd="@dimen/value_15dp"
                android:text="@string/emergency_btn_text"
                android:textColor="@color/light_button_text"
                android:textSize="@dimen/regular_size_16"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:itemIconSize="@dimen/value_24dp"
            app:itemIconTint="@color/bottom_nav_colors"
            app:itemTextColor="@color/bottom_nav_colors"
            android:background="@drawable/bottom_nav_bg"
            android:layout_marginStart="@dimen/activity_padding"
            android:layout_marginEnd="@dimen/activity_padding"
            android:layout_marginBottom="@dimen/value_15dp"
            app:itemRippleColor="@android:color/transparent"
            app:itemBackground="@drawable/bottom_nav_item_bg"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/bottom_navigation_menu" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/sideNavigationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconSize="@dimen/value_24dp"
        app:itemTextColor="?attr/color_text_75"
        app:itemIconTint="?attr/color_text_75"
        app:headerLayout="@layout/side_navigation_header"
        app:menu="@menu/side_navigation_menu" />

</androidx.drawerlayout.widget.DrawerLayout>