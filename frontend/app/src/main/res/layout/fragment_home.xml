<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/activity_padding"
        android:paddingVertical="@dimen/value_15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hi Kusal!"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/size_24"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How are you today?"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

            </LinearLayout>

            <!--            <LinearLayout-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:orientation="horizontal">-->

            <!--                <TextView-->
            <!--                    android:id="@+id/homeRecoveryDayBadge"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="35dp"-->
            <!--                    android:background="@drawable/card_bg"-->
            <!--                    android:paddingStart="@dimen/value_15dp"-->
            <!--                    android:paddingTop="@dimen/value_8dp"-->
            <!--                    android:paddingEnd="@dimen/value_15dp"-->
            <!--                    android:paddingBottom="@dimen/value_8dp"-->
            <!--                    android:text="Recovery Day 01"-->
            <!--                    android:textAlignment="center"-->
            <!--                    android:textColor="?attr/color_text_75"-->
            <!--                    android:textSize="@dimen/size_14" />-->

            <!--            </LinearLayout>-->

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileIncompleteView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_15dp"
            android:background="@drawable/emergency_btn_bg"
            android:orientation="vertical"
            android:padding="@dimen/value_15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complete your profile to add emergency and caregiver contact details."
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/size_17" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/value_15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_session_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/value_35dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:text="You're doing great, keep going!"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/size_20"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/homeNextExerciseName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/value_8dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Small steps today lead to big wins tomorrow"
                            android:textColor="?attr/color_text_75"
                            android:textSize="@dimen/size_12" />

                        <!--                        <LinearLayout-->
                        <!--                            android:layout_width="match_parent"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            android:layout_marginTop="@dimen/value_15dp"-->
                        <!--                            android:gravity="center"-->
                        <!--                            android:orientation="horizontal">-->

                        <!--                            <Button-->
                        <!--                                android:id="@+id/homeExerciseStartNowBtn"-->
                        <!--                                android:layout_width="0dp"-->
                        <!--                                android:layout_height="wrap_content"-->
                        <!--                                android:layout_weight="1"-->
                        <!--                                android:text="Start Now →"-->
                        <!--                                android:textSize="@dimen/size_12" />-->

                        <!--                            <TextView-->
                        <!--                                android:id="@+id/homeCompletedExercisesCount"-->
                        <!--                                android:layout_width="wrap_content"-->
                        <!--                                android:layout_height="wrap_content"-->
                        <!--                                android:layout_marginStart="@dimen/value_15dp"-->
                        <!--                                android:text="1/5"-->
                        <!--                                android:textColor="?attr/color_text_75"-->
                        <!--                                android:textSize="@dimen/size_14" />-->

                        <!--                        </LinearLayout>-->
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/value_8dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg_2"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/value_8dp"
                android:paddingStart="@dimen/value_15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heart Rate"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />

                <TextView
                    android:id="@+id/heartRateBpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="-- bpm"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/size_24"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/heartRateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NORMAL"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_11" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallCaregiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="@dimen/value_8dp"
                    android:background="@drawable/chip_bg_2"
                    android:text="Call Caregiver"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    app:backgroundTint="@null"
                    app:strokeColor="?attr/color40"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:visibility="gone"
                    android:id="@+id/btnCheckHeartRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_bg_2"
                    android:text="Check Heart Rate"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    app:backgroundTint="@null"
                    app:strokeColor="?attr/color40"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/value_8dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>