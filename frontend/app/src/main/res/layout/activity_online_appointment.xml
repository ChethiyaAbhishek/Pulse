<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.OnlineAppointmentActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/onlineAppointmentContainer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/upComingSessionPreview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/activity_padding"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/value_30dp"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/onlineAppointmentBtnBack"
                android:layout_width="@dimen/circular_btn"
                android:layout_height="@dimen/circular_btn"
                android:layout_alignParentStart="true"
                android:background="@drawable/circular_btn_shape"
                android:src="@drawable/back_arrow" />

            <Button
                android:id="@+id/onlineAppointmentBtnEmergency"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_alignParentEnd="true"
                android:background="@drawable/emergency_btn_bg"
                android:paddingStart="@dimen/value_15dp"
                android:paddingEnd="@dimen/value_15dp"
                android:text="@string/emergency_btn_text"
                android:textColor="@color/light_button_text"
                android:textSize="@dimen/regular_size_16"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/health_icon"
                tools:layout_editor_absoluteY="157dp" />

            <TextView
                android:id="@+id/onlineAppointmentConsultantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr Isuru Gallage"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/value_24dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/size_32"
                android:textStyle="bold" />

<!--            <TextView-->
<!--                android:id="@+id/onlineAppointmentConsultantSpeciality"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="Neurologist"-->
<!--                android:textAlignment="center"-->
<!--                android:textAllCaps="true"-->
<!--                android:textColor="?attr/color70"-->
<!--                android:textSize="@dimen/size_13"/>-->

            <TextView
                android:id="@+id/onlineAppointmentSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="04.30 PM - 05.00 PM"
                android:textAlignment="center"
                android:layout_marginVertical="@dimen/value_35dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/size_24" />

            <TextView
                android:id="@+id/onlineAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feb 13 2026"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/value_8dp"
                android:textColor="?attr/color40"
                android:textSize="@dimen/size_17" />

            <TextView
                android:id="@+id/onlineAppointmentHospital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nawaloka Hospitals PLC"
                android:textAlignment="center"
                android:textColor="?attr/color40"
                android:textSize="@dimen/size_17" />

        </LinearLayout>

        <TextView
            android:id="@+id/onlineAppointmentInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your session has not started yet."
            android:textAlignment="center"
            android:layout_marginTop="@dimen/value_18dp"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_17" />
    </LinearLayout>
</LinearLayout>