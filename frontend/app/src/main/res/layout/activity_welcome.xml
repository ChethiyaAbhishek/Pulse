<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:padding="@dimen/activity_padding"
        tools:context=".activity.WelcomeActivity">

        <TextView
            android:id="@+id/welcome_act_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_family"
            android:text="@string/app_name"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_48"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/welcome_act_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/welcome_act_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/welcome_act_heading"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_act_name"
            app:srcCompat="@drawable/welcome_act_img"
            tools:layout_editor_absoluteY="157dp" />

        <TextView
            android:id="@+id/welcome_act_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_15dp"
            android:fontFamily="@font/inter_family"
            android:text="@string/welcome_act_heading"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/size_24"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/welcome_act_subtext"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_act_img" />

        <TextView
            android:id="@+id/welcome_act_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_15dp"
            android:paddingHorizontal="@dimen/padding_10"
            android:text="@string/welcome_act_subtext"
            android:textAlignment="center"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_14"
            app:layout_constraintBottom_toTopOf="@id/get_started_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_act_heading" />

        <Button
            android:id="@+id/get_started_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/value_30dp"
            android:text="@string/get_started_btn_text"
            android:textAlignment="center"
            android:textSize="@dimen/size_17"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_act_subtext" />

