<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_padding"
    tools:context=".activity.SettingsSubActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/settingsSubBtnBack"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:layout_alignParentStart="true"
            android:background="@drawable/circular_btn_shape"
            android:src="@drawable/back_arrow" />

        <Button
            android:id="@+id/settingsSubBtnEmergency"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_alignParentEnd="true"
            android:background="@drawable/emergency_btn_bg"
            android:paddingStart="@dimen/value_15dp"
            android:paddingEnd="@dimen/value_15dp"
            android:text="@string/emergency_btn_text"
            android:textColor="@color/light_button_text"
            android:textSize="@dimen/regular_size_16"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/value_24dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settingsSubFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>