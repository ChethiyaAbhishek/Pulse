<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_padding"
    tools:context=".activity.AppointmentActivity">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/circular_btn"
        android:layout_height="@dimen/circular_btn"
        android:background="@drawable/circular_btn_shape"
        android:src="@drawable/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnEmergency"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/btn_height"
        android:background="@drawable/emergency_btn_bg"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:text="@string/emergency_btn_text"
        android:textColor="@color/light_button_text"
        android:textSize="@dimen/regular_size_16"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHospitalName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_24dp"
        android:text="Nawaloka Hospitals PLC"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_24"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Book instantly and track follow-ups in Pulse."
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHospitalName" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contactContainer"
        android:layout_width="0dp"
        android:layout_height="175dp"
        android:layout_marginTop="16dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <ImageButton
            android:id="@+id/btnLocation"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:background="@drawable/circular_btn_shape"
            android:layout_margin="16dp"
            android:contentDescription="Location"
            android:src="@drawable/back_arrow"
            android:layout_marginBottom="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnPhone"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:background="@drawable/circular_btn_shape"
            android:layout_margin="16dp"
            android:contentDescription="Location"
            android:src="@drawable/back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Location Section -->
    <TextView
        android:id="@+id/tvLocationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Location"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contactContainer" />

    <HorizontalScrollView
        android:id="@+id/locationScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLocationLabel">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipColombo3_1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Colombo 3"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGalle1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Galle"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipColombo3_2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Colombo 3"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGalle2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Galle"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipColombo"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colombo"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Doctor Section -->
    <TextView
        android:id="@+id/tvDoctorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Doctor"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/locationScrollView" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/doctorSearchContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/search_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDoctorLabel">

        <EditText
            android:id="@+id/etSearchDoctor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:hint="Search Doctor"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@android:color/white"
            android:textColorHint="#808080"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnVoiceSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnVoiceSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voice Search"
            android:src="@drawable/ic_mic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSearch"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Search"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <HorizontalScrollView
        android:id="@+id/doctorScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/doctorSearchContainer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDrIsuru"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Dr. Isuru Gallage"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProfM1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Prof M Rathnayake"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProfM2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prof M Rathnayak"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Appointment Date Section -->
    <TextView
        android:id="@+id/tvDateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Appointment Date"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/doctorScrollView" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dateContainer"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_container_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDateLabel" />

    <!-- Appointment Time Section -->
    <TextView
        android:id="@+id/tvTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Appointment Time"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateContainer" />

    <HorizontalScrollView
        android:id="@+id/timeScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTimeLabel">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="07:00 PM"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#4CAF50" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="07:30 PM"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime3"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="07:30 PM"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime4"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:30 PM"
                android:textColor="@android:color/white"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="#2D2D2D" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Appointment Mode Section -->
    <TextView
        android:id="@+id/tvModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Appointment Mode"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeScrollView" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModeLabel"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOnsite"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Onsite"
            android:textColor="@android:color/white"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="#4CAF50" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOnline"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textColor="@android:color/white"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="#2D2D2D" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Payment Section -->
    <TextView
        android:id="@+id/tvPaymentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Payment"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroupMode" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paymentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_container_dark"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPaymentLabel">

        <TextView
            android:id="@+id/tvTherapistLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Therapist Charges"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvTherapistAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTherapistAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LKR 6000.0"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHospitalLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hospital Charges"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvHospitalAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTherapistLabel" />

        <TextView
            android:id="@+id/tvHospitalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LKR 1000.0"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTherapistAmount" />

        <TextView
            android:id="@+id/tvPlatformLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Platform Charges"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvPlatformAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHospitalLabel" />

        <TextView
            android:id="@+id/tvPlatformAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LKR 500.0"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHospitalAmount" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#404040"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPlatformLabel" />

        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Total Amount"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvTotalAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LKR 7500.0"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pay & Book Now Button -->
    <Button
        android:id="@+id/btnPayBookNow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pay_button_bg"
        android:text="Pay &amp; Book Now"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/paymentContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>