<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_padding"
    tools:context=".fragment.Reg03Fragment">

    <ImageButton
        android:id="@+id/reg3_btnBack"
        android:layout_width="@dimen/circular_btn"
        android:layout_height="@dimen/circular_btn"
        android:background="@drawable/circular_btn_shape"
        android:src="@drawable/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/reg3_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/padding_10"
        android:text="@string/reg3_title_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_32"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg3_btnBack" />

    <TextView
        android:id="@+id/reg3_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/reg3_subtitle_text"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg3_title" />

    <LinearLayout
        android:id="@+id/progressIndicator3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg3_subtitle">

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_marginStart="@dimen/value_8dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_marginStart="@dimen/value_8dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_active" />
    </LinearLayout>

    <TextView
        android:id="@+id/dateOfStrokeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/dos_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator3" />

    <EditText
        android:id="@+id/dateOfStrokeField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/calendar_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/dos_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateOfStrokeLabel" />

    <TextView
        android:id="@+id/cFnameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/cfn_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateOfStrokeField" />

    <EditText
        android:id="@+id/cFnameField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/user_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/cfn_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cFnameLabel" />

    <TextView
        android:id="@+id/cLnameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/cln_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cFnameField" />

    <EditText
        android:id="@+id/cLnameField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/user_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/cln_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cLnameLabel" />

    <TextView
        android:id="@+id/cContactLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/ccontact_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cLnameField" />

    <EditText
        android:id="@+id/cContactField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/mobile_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/cc_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cContactLabel" />

    <TextView
        android:id="@+id/eContactLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/ec_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cContactField" />

    <EditText
        android:id="@+id/eContactField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:hint="@string/ec_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:drawableStart="@drawable/announcement_icon"
        android:drawablePadding="@dimen/padding_10"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eContactLabel" />

    <TextView
        android:id="@+id/ecHelperText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_8dp"
        android:text="@string/ec_helper_text"
        android:textColor="?attr/colorAuthFooter"
        android:textSize="@dimen/size_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eContactField" />

    <Button
        android:id="@+id/regFinalizeBtn"
        android:layout_width="@dimen/btn_width"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="40dp"
        android:text="@string/regf_btn_text"
        android:textSize="@dimen/size_17"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ecHelperText" />


</androidx.constraintlayout.widget.ConstraintLayout>