<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="@dimen/value_24dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/card_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Section Header"
        android:textSize="@dimen/regular_size_16"
        android:textColor="?attr/colorAuthSubtext1"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/card_section_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_15dp" />

    <com.google.android.material.chip.Chip
        android:id="@+id/cardSectionResultNotFound"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/value_8dp"
        android:paddingEnd="@dimen/value_8dp"
        android:visibility="gone"
        android:text="No Results Found  "
        android:textColor="?attr/color_text_75"
        app:checkedIconVisible="false"
        app:chipBackgroundColor="?attr/colorCardBg" />

    <LinearLayout
        android:id="@+id/extraContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>