<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_padding"
    android:paddingTop="@dimen/activity_padding"
    android:paddingBottom="@dimen/value_8dp"
    tools:context=".fragment.ChannelFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/activity_padding"
            android:text="Find a Doctor"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/size_24"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/activity_padding"
            android:text="Book instantly and track follow-ups in Pulse."
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_24dp"
            android:orientation="horizontal"
            android:paddingRight="@dimen/activity_padding">

            <EditText
                android:id="@+id/channel_search_field"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/value_45dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:drawableEnd="@drawable/audio_icon"
                android:drawablePadding="@dimen/padding_10"
                android:hint="Search by consultant or hospital"
                android:inputType="text"
                android:padding="@dimen/padding_10"
                android:textColor="?attr/color_text_75"
                android:textColorHint="?attr/color_text_75"
                android:textSize="@dimen/size_14" />

            <ImageButton
                android:id="@+id/channel_search_btn"
                android:layout_width="@dimen/value_45dp"
                android:layout_height="@dimen/value_45dp"
                android:layout_marginStart="@dimen/value_5dp"
                android:background="@drawable/circular_btn_shape"
                android:src="@drawable/search_icon" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/activity_padding">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="@dimen/value_40dp"
                android:padding="0dp"
                android:visibility="gone"
                android:text="Neurology"
                android:textSize="@dimen/size_12" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:visibility="gone"
                android:layout_height="@dimen/value_40dp"
                android:text="Physiotherapy"
                android:textSize="@dimen/size_12" />

            <com.google.android.material.chip.Chip
                android:id="@+id/clearSearchChip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/value_40dp"
                android:text="Clear Search"
                android:textSize="@dimen/size_12" />

        </com.google.android.material.chip.ChipGroup>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/channelBodyContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/channel_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/channelLoadingContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
