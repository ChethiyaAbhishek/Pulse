<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/value_8dp"
    android:layout_marginBottom="@dimen/value_8dp"
    app:cardCornerRadius="@dimen/value_15dp">

    <LinearLayout
        android:id="@+id/hospital_card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorCardBg"
        android:orientation="vertical"
        android:padding="@dimen/value_5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/value_8dp">

            <ImageView
                android:id="@+id/hospital_card_img"
                android:layout_width="95dp"
                android:layout_height="95dp"
                android:background="@drawable/card_bg"
                android:clipToOutline="true"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/value_8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hospital_card_name"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Nawaloka Hospitals PLC"
                        android:textColor="?attr/color_text_75"
                        android:textSize="@dimen/regular_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hospital_card_address"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="123, Ollcot Lane, Colombo 05."
                        android:textColor="?attr/color70"
                        android:textSize="@dimen/size_12" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/value_8dp"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/hospital_card_call_btn"
                        android:layout_width="@dimen/value_35dp"
                        android:layout_height="@dimen/value_35dp"
                        android:background="@drawable/appointment_card_btn_bg"
                        android:src="@drawable/call_icon" />

                    <ImageButton
                        android:id="@+id/hospital_card_location_btn"
                        android:layout_width="@dimen/value_35dp"
                        android:layout_height="@dimen/value_35dp"
                        android:layout_marginTop="@dimen/value_24dp"
                        android:background="@drawable/appointment_card_btn_bg"
                        android:src="@drawable/location_icon" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Available Doctors (TODAY)"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_11"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hospital_card_doc_availability_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>