<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/value_15dp"
    android:layout_marginStart="@dimen/value_8dp">

    <LinearLayout
        android:id="@+id/appointment_card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorGreenCard"
        android:orientation="vertical"
        android:padding="@dimen/value_15dp">

        <TextView
            android:id="@+id/appointment_card_doctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dr. Sahan Ekanayakemmmmm"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/size_20"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableRow android:layout_gravity="center">

                <TextView
                    android:layout_weight="1"
                    android:id="@+id/appointment_card_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9.00 PM - 9.30 PM"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_15"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appointment_card_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/value_8dp"
                    android:background="@drawable/appointment_date_bg"
                    android:gravity="center"
                    android:paddingStart="@dimen/padding_10"
                    android:paddingEnd="@dimen/padding_10"
                    android:paddingVertical="@dimen/value_5dp"
                    android:text="Today"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/size_11" />
            </TableRow>

            <TableRow android:layout_marginTop="@dimen/value_5dp">

                <TextView
                    android:layout_weight="1"
                    android:id="@+id/appointment_card_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/padding_10"
                    android:maxLines="2"
                    android:text="Ruhunu Hospital, Karapitiya"
                    android:textColor="?attr/color70"
                    android:textSize="@dimen/size_12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/appointment_card_location_btn"
                        android:layout_width="@dimen/value_45dp"
                        android:layout_height="@dimen/value_45dp"
                        android:background="@drawable/appointment_card_btn_bg"
                        android:src="@drawable/location_icon" />

                    <ImageButton
                        android:id="@+id/appointment_card_video_btn"
                        android:layout_width="@dimen/value_45dp"
                        android:layout_height="@dimen/value_45dp"
                        android:layout_marginStart="@dimen/value_5dp"
                        android:background="@drawable/appointment_card_btn_bg"
                        android:src="@drawable/video_icon" />

                </LinearLayout>
            </TableRow>

        </TableLayout>

    </LinearLayout>


</com.google.android.material.card.MaterialCardView>