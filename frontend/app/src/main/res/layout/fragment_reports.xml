<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".fragment.ReportsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingRight="@dimen/activity_padding"
                android:text="Medical Reports"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/size_24"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingRight="@dimen/activity_padding"
                android:text="View your lab reports anytime"
                android:textColor="?attr/color_text_75"
                android:textSize="@dimen/size_14" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/addReport"
            android:layout_width="@dimen/circular_btn"
            android:layout_height="@dimen/circular_btn"
            android:layout_alignParentStart="true"
            android:background="@drawable/circular_btn_shape"
            android:src="@drawable/image_upload_icon" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reportFragmentRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/value_24dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/noReportsCard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/value_35dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/value_15dp">
        <LinearLayout
            android:id="@+id/consultantCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="?attr/colorCardBg"
            android:orientation="vertical"
            android:padding="@dimen/padding_10">
            <TextView
                android:id="@+id/consultant_card_base_hospital"
                android:layout_width="match_parent"
                android:textAlignment="center"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="No Uploaded Reports"
                android:textColor="?attr/color_text_75"
                android:textSize="@dimen/size_12" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>