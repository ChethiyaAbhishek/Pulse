<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragment.PermissionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/value_8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingRight="@dimen/activity_padding"
                    android:text="Permissions"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/size_24"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingRight="@dimen/activity_padding"
                    android:text="Your privacy, your control"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_14" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/color_text_75" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/value_24dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_communication"
                android:textStyle="bold"
                android:textSize="@dimen/size_20"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required for emergency purposes"
                android:textSize="@dimen/size_12"
                android:textColor="?attr/color_text_75"
                android:layout_marginBottom="@dimen/value_15dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionCall"
                android:layout_width="match_parent"
                android:textColor="?attr/color_text_75"
                android:layout_height="wrap_content"
                android:text="Automated Emergency Calls"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionCallState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/color_text_75"
                android:text="Read Phone State For Emergency Calls"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Automated Emergency SMS"
                android:textColor="?attr/color_text_75"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/value_24dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textStyle="bold"
                android:textSize="@dimen/size_20"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required for location based hospital suggestions"
                android:textSize="@dimen/size_12"
                android:textColor="?attr/color_text_75"
                android:layout_marginBottom="@dimen/value_15dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionLocation"
                android:layout_width="match_parent"
                android:textColor="?attr/color_text_75"
                android:layout_height="wrap_content"
                android:text="Location Access"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/value_24dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/media_hardware"
                android:textStyle="bold"
                android:textSize="@dimen/size_20"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required for telemedicine features"
                android:textSize="@dimen/size_12"
                android:textColor="?attr/color_text_75"
                android:layout_marginBottom="@dimen/value_15dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/color_text_75"
                android:text="Camera Access"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/color_text_75"
                android:text="Audio Access"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/color_text_75"
                android:text="Bluetooth Access"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionStorage"
                android:layout_width="match_parent"
                android:textColor="?attr/color_text_75"
                android:layout_height="wrap_content"
                android:text="Storage Access"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/value_24dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textStyle="bold"
                android:textSize="@dimen/size_20"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required for application notifications"
                android:textSize="@dimen/size_12"
                android:textColor="?attr/color_text_75"
                android:layout_marginBottom="@dimen/value_15dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/permissionNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/color_text_75"
                android:text="Enable Notifications"
                android:textSize="@dimen/size_14"
                android:padding="@dimen/value_8dp" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>