<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_padding"
    tools:context=".fragment.Reg01Fragment">

    <ImageButton
        android:id="@+id/reg1_btnBack"
        android:layout_width="@dimen/circular_btn"
        android:layout_height="@dimen/circular_btn"
        android:background="@drawable/circular_btn_shape"
        android:src="@drawable/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/reg1_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_10"
        android:text="@string/reg1_title_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_32"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg1_btnBack"/>

    <TextView
        android:id="@+id/reg1_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reg1_subtitle_text"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg1_title"/>

    <LinearLayout
        android:id="@+id/progressIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/value_30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg1_subtitle">

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_active"/>

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/value_8dp"
            android:background="@drawable/progress_indicator_inactive"/>

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/value_8dp"
            android:background="@drawable/progress_indicator_inactive"/>
    </LinearLayout>

    <TextView
        android:id="@+id/firstNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/first_name_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        android:layout_marginTop="@dimen/value_30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator"/>

    <EditText
        android:id="@+id/firstNameField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_55dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:hint="@string/firstname_field_hint"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstNameLabel"/>

    <TextView
        android:id="@+id/lastNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/last_name_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        android:layout_marginTop="@dimen/value_30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstNameField"/>

    <EditText
        android:id="@+id/lastNameField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_55dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:hint="@string/last_name_field_hint"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lastNameLabel"/>

    <TextView
        android:id="@+id/mobileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mobile_number_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        android:layout_marginTop="@dimen/value_30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lastNameField"/>

    <EditText
        android:id="@+id/mobileField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_55dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:hint="@string/mobile_field_hint"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        android:inputType="phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobileLabel"/>

    <TextView
        android:id="@+id/dobLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dob_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        android:layout_marginTop="@dimen/value_30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobileField"/>

    <EditText
        android:id="@+id/dobField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_55dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:hint="@string/dob_field_hint_text"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dobLabel"/>

    <TextView
        android:id="@+id/genderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gender_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        android:layout_marginTop="@dimen/value_30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dobField"/>

    <AutoCompleteTextView
        android:id="@+id/genderField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_55dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:hint="@string/gender_field_hint_text"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/genderLabel"/>

    <Button
        android:id="@+id/reg1_btnNext"
        android:layout_width="@dimen/btn_width"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="40dp"
        android:text="@string/reg1_btn_next_text"
        android:textSize="@dimen/size_17"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/genderField"/>

    <TextView
        android:id="@+id/reg1_footerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reg1_footer_text"
        android:textColor="?attr/colorAuthSubtext1"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintEnd_toStartOf="@id/reg1_loginLink"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg1_btnNext"/>

    <TextView
        android:id="@+id/reg1_loginLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reg1_login_link_text"
        android:textColor="?attr/colorAuthLink"
        android:textSize="@dimen/regular_size_16"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/value_8dp"
        android:clickable="true"
        android:focusable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/reg1_footerText"
        app:layout_constraintTop_toTopOf="@id/reg1_footerText"/>

</androidx.constraintlayout.widget.ConstraintLayout>