<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/value_8dp"
    app:cardCornerRadius="@dimen/value_15dp">

    <LinearLayout
        android:id="@+id/prescriptionItemCardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="?attr/colorCardBg"
        android:orientation="vertical"
        android:padding="@dimen/padding_10">

        <TextView
            android:id="@+id/prescriptionItemMedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Amoxicillin"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_20"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_8dp"
            android:columnCount="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dose"
                    android:textAlignment="center"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_12" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/prescriptionItemDoseChip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:text="500 mg"
                    android:textSize="@dimen/size_10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frequency"
                    android:textAlignment="center"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_12" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/prescriptionItemFrequencyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:text="3 / Day"
                    android:textSize="@dimen/size_10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Duration"
                    android:textAlignment="center"
                    android:textColor="?attr/color_text_75"
                    android:textSize="@dimen/size_12" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/prescriptionItemDurationChip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:text="14 Days"
                    android:textSize="@dimen/size_10" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:id="@+id/prescriptionItemInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_5dp"
            android:text="Take after meals with a full glass of water"
            android:textColor="?attr/colorAuthSubtext1"
            android:textSize="@dimen/size_12" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>