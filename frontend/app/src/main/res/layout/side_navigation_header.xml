<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/activity_padding">

    <ImageView
        android:id="@+id/header_prof_img"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <LinearLayout
        android:layout_width="0dp"
        android:gravity="start"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/header_prof_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider"
        android:orientation="vertical">

        <TextView
            android:id="@+id/header_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_24dp"
            android:text="Kasun De Silva"
            android:textAlignment="textStart"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/size_24"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_24dp"
            android:layout_marginBottom="@dimen/value_15dp"
            android:text="Patient"
            android:textAlignment="textStart"
            android:textAllCaps="true"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_17"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_5dp"
        android:layout_marginTop="@dimen/value_15dp"
        android:background="@drawable/progress_indicator_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_prof_img" />

</androidx.constraintlayout.widget.ConstraintLayout>