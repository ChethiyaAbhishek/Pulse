<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_padding"
    tools:context=".fragment.Reg02Fragment">

    <ImageButton
        android:id="@+id/reg2_btnBack"
        android:layout_width="@dimen/circular_btn"
        android:layout_height="@dimen/circular_btn"
        android:background="@drawable/circular_btn_shape"
        android:src="@drawable/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/reg2_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_15dp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/padding_10"
        android:text="@string/reg2_title_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_32"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg2_btnBack" />

    <TextView
        android:id="@+id/reg2_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/reg2_subtitle_text"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg2_title" />

    <LinearLayout
        android:id="@+id/progressIndicator2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reg2_subtitle">

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_marginStart="@dimen/value_8dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/value_5dp"
            android:layout_marginStart="@dimen/value_8dp"
            android:layout_weight="1"
            android:background="@drawable/progress_indicator_inactive" />
    </LinearLayout>

    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/email_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator2" />

    <EditText
        android:id="@+id/emailField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/email_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/email_field_hint"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailLabel" />

    <TextView
        android:id="@+id/emailError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_15dp"
        android:layout_marginTop="@dimen/value_5dp"
        android:text="* Email is required."
        android:textColor="@color/emergency_button_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailField" />

    <TextView
        android:id="@+id/passwordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/password_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailError" />

    <EditText
        android:id="@+id/passwordField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/lock_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/password_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:inputType="textPassword"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordLabel" />

    <TextView
        android:id="@+id/passwordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_15dp"
        android:layout_marginTop="@dimen/value_5dp"
        android:text="* Password is required."
        android:textColor="@color/emergency_button_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordField" />

    <TextView
        android:id="@+id/confirmPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/confirm_password_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordError" />

    <EditText
        android:id="@+id/confirmPasswordField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:inputType="textPassword"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/lock_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/confirm_password_field_hint_text"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmPasswordLabel" />

    <TextView
        android:id="@+id/conPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_15dp"
        android:layout_marginTop="@dimen/value_5dp"
        android:text="* Password confirmation is required."
        android:textColor="@color/emergency_button_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmPasswordField" />

    <Button
        android:id="@+id/createAccountBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="40dp"
        android:text="@string/create_account_btn_text"
        android:textSize="@dimen/size_17"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/reg2_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/conPasswordError" />

    <TextView
        android:id="@+id/reg2_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/reg2_footer_text"
        android:textColor="?attr/colorAuthFooter"
        android:textSize="@dimen/size_14"
        android:layout_marginTop="@dimen/value_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/createAccountBtn" />


</androidx.constraintlayout.widget.ConstraintLayout>