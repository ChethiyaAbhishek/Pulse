<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/value_8dp"
    app:cardCornerRadius="@dimen/value_15dp">

    <LinearLayout
        android:id="@+id/prescriptionCardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="?attr/colorCardBg"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_10"
        android:paddingEnd="@dimen/padding_10"
        android:paddingBottom="@dimen/padding_10">

        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_alignParentStart="true"
                android:id="@+id/prescriptionCardDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/appointment_date_bg"
                android:gravity="center"
                android:paddingVertical="@dimen/value_5dp"
                android:layout_centerInParent="true"
                android:paddingStart="@dimen/padding_10"
                android:paddingEnd="@dimen/padding_10"
                android:text="6 FEB 2026"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/size_11" />

            <com.google.android.material.chip.Chip
                android:layout_alignParentEnd="true"
                android:id="@+id/prescriptionCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:padding="0dp"
                android:layout_marginStart="@dimen/value_15dp"
                android:text="Active"
                android:textSize="@dimen/size_10" />
        </RelativeLayout>

        <TextView
            android:id="@+id/prescriptionCardConsulName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Dr Isuru Gallage"
            android:textColor="?attr/color_text_75"
            android:textSize="@dimen/size_20"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prescriptionCardNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heres the comment"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/color40"
            android:textSize="@dimen/size_12" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>