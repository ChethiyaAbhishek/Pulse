<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/reportCardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/value_8dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/reportCardImage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_margin="@dimen/value_8dp"
            android:background="@drawable/card_bg"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/reportCardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_8dp"
            android:layout_marginEnd="@dimen/value_8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text=""
            android:textAlignment="center"
            android:textColor="?attr/color70"
            android:textSize="@dimen/size_12" />

        <TextView
            android:id="@+id/reportCardUploadedDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_8dp"
            android:layout_marginEnd="@dimen/value_8dp"
            android:layout_marginBottom="@dimen/value_8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:layout_marginTop="2dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="?attr/color40"
            android:textSize="@dimen/size_11" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>