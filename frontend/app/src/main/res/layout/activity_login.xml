<!--            android:clickable="true"-->
<!--            android:focusable="true"-->
<!--            android:src="@drawable/face_recog_icon" />-->
<!--    </LinearLayout>-->

    <TextView
        android:id="@+id/loginFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_footer_text"
        android:textColor="?attr/colorAuthFooter"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/login_reg_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signInBtn" />

    <TextView
        android:id="@+id/login_reg_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/login_reg_text"
        android:textColor="?attr/colorAuthLink"
        android:textSize="@dimen/regular_size_16"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/loginFooter"
        app:layout_constraintTop_toTopOf="@id/loginFooter" />

</androidx.constraintlayout.widget.ConstraintLayout>