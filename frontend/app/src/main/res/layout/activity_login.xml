    <Button
        android:id="@+id/emergencyBtnLogin"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/btn_height"
        android:background="@drawable/emergency_btn_bg"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:text="@string/emergency_btn_text"
        android:textColor="@color/light_button_text"
        android:textSize="@dimen/regular_size_16"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_35dp"
        android:gravity="center"
        android:text="@string/login_title_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/size_32"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emergencyBtnLogin" />

    <TextView
        android:id="@+id/loginAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/size_32"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginTitle" />

    <TextView
        android:id="@+id/loginSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/login_subtitle_text"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginAppName" />

    <TextView
        android:id="@+id/loginEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/email_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSubtitle" />

    <EditText
        android:id="@+id/loginEmailField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/email_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/email_field_hint"
        android:inputType="textEmailAddress"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginEmailLabel" />

    <TextView
        android:id="@+id/loginEmailError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_15dp"
        android:layout_marginTop="@dimen/value_5dp"
        android:text="* Email is required."
        android:textColor="@color/emergency_button_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginEmailField" />

    <TextView
        android:id="@+id/loginPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_30dp"
        android:text="@string/password_label_text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/regular_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginEmailError" />

    <EditText
        android:id="@+id/loginPasswordField"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_45dp"
        android:layout_marginTop="@dimen/value_8dp"
        android:background="@drawable/textfield_background"
        android:drawableStart="@drawable/lock_icon"
        android:drawablePadding="@dimen/padding_10"
        android:hint="@string/password_field_hint_text"
        android:inputType="textPassword"
        android:paddingStart="@dimen/value_15dp"
        android:paddingEnd="@dimen/value_15dp"
        android:textColor="?attr/color_text_75"
        android:textColorHint="?attr/color_text_75"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginPasswordLabel" />

    <TextView
        android:id="@+id/loginPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_15dp"
        android:layout_marginTop="@dimen/value_5dp"
        android:text="* Password is required."
        android:textColor="@color/emergency_button_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginPasswordField" />

    <TextView
        android:id="@+id/loginForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/forgot_password_text"
        android:textColor="?attr/color_text_75"
        android:textSize="@dimen/size_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginPasswordError" />

    <Button
        android:id="@+id/signInBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="40dp"
        android:text="@string/sign_in_text"
        android:textSize="@dimen/size_17"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginForgotPassword" />

