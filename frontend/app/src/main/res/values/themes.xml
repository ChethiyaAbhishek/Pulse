<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme shared between light and dark -->
    <style name="Theme.Pulse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core colors -->
        <item name="colorPrimary">@color/light_primary_green</item>
        <item name="colorPrimaryVariant">@color/light_primary_green
        </item> <!-- or darker tint if you create one -->
        <item name="colorOnPrimary">@color/light_button_text</item>

        <item name="colorSecondary">@color/light_primary_green</item>
        <item name="colorSecondaryVariant">@color/light_primary_green</item>
        <item name="colorOnSecondary">@color/light_button_text</item>

        <!-- Background & surface -->
        <item name="android:windowBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_background</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorSurfaceVariant">@color/light_card_bg</item>
        <item name="colorOnSurfaceVariant">@color/light_text_sub</item>

        <!--    Custom Colors    -->
        <item name="colorCopyright">@color/light_text_copyright</item>
        <item name="color_text_75">@color/light_text_75</item>
        <item name="colorBg65">@color/light_bg_75</item>
        <item name="progressIndicatorActive">@color/light_green_80</item>
        <item name="progressIndicatorInactive">@color/light_green_20</item>
        <item name="colorTextField">@color/light_textfield_bg</item>
        <item name="colorAuthSubtext1">@color/light_text_85</item>
        <item name="colorAuthLink">@color/light_text_green_95</item>
        <item name="colorAuthFooter">@color/light_text_55</item>
        <item name="colorBtmNavBg">@color/light_bottom_nav_bg</item>
        <item name="colorBtmNavBgSelected">@color/light_nav_bg_selected</item>
        <item name="colorCardBg">@color/light_card_bg</item>
        <item name="colorAppointD">@color/light_badge_bg_25</item>
        <item name="colorGreenCard">@color/light_green_65</item>
        <item name="color70">@color/light_text_70</item>
        <item name="colorAppointCardBtnBg">@color/light_badge_bg_15</item>
        <item name="colorGreen30">@color/light_green_30</item>
        <item name="colorWhiteChipBg">@color/light_badge_bg_white_65</item>
        <item name="color40">@color/light_text_40</item>


        <!-- Error / emergency -->
        <item name="colorError">@color/emergency_button_bg</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- Status & navigation bar -->
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">true
        </item>          <!-- dark icons on light bg -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Text appearances -->
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="fontFamily">@font/inter_family</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Material3.HeadlineLarge</item>
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_sub</item>

        <item name="textAppearanceTitleLarge">@style/AppText</item>
        <item name="textAppearanceTitleMedium">@style/AppText</item>
        <item name="textAppearanceBodySmall">@style/AppText</item>
        <item name="textAppearanceBodyLarge">@style/AppText</item>
        <item name="textAppearanceBodyMedium">@style/AppText</item>
        <item name="textAppearanceLabelLarge">@style/AppButtonText</item>
    </style>

    <style name="AppText" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <style name="AppButtonText" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_family</item>
    </style>


    <!-- Light theme (applied by default) -->
    <!--<style name="Theme.Pulse" parent="Theme.Pulse" />-->

</resources>